datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

model Organization {
  id        String   @id @default(uuid())
  name      String
  bin       String?  // Business Identification Number (БИН KZ)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  branches  Branch[]
  users     User[]
}

model Branch {
  id              String           @id @default(uuid())
  organizationId  String
  name            String
  address         String?
  phone           String?
  organization    Organization     @relation(fields: [organizationId], references: [id])
  warehouses      Warehouse[]
  posIntegrations POSIntegration[]
  users           UserBranch[]
  diningTables    DiningTable[]
  orders          Order[]
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt
}

model DiningTable {
  id        String   @id @default(uuid())
  branchId  String
  label     String   // e.g. "Стол 7"
  qrSlug    String   @unique // e.g. "table-7"
  branch    Branch   @relation(fields: [branchId], references: [id])
  orders    Order[]
  createdAt DateTime @default(now())
}

model Warehouse {
  id          String          @id @default(uuid())
  branchId    String
  name        String          // e.g. "Главный склад кухни", "Бар"
  isMain      Boolean         @default(false)
  branch      Branch          @relation(fields: [branchId], references: [id])
  balances    StockBalance[]
  movements   StockMovement[]
}

model User {
  id             String       @id @default(uuid())
  organizationId String
  email          String       @unique
  phone          String?
  passwordHash   String
  fullName       String
  role           String       // OWNER, MANAGER, STOREKEEPER, CHEF
  organization   Organization @relation(fields: [organizationId], references: [id])
  branches       UserBranch[]
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt
}

model UserBranch {
  userId   String
  branchId String
  user     User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  branch   Branch @relation(fields: [branchId], references: [id], onDelete: Cascade)

  @@id([userId, branchId])
}

model POSIntegration {
  id            String   @id @default(uuid())
  branchId      String
  provider      String   @default("NEXIUM")
  apiKey        String
  apiSecret     String
  webhookSecret String
  isActive      Boolean  @default(true)
  branch        Branch   @relation(fields: [branchId], references: [id])
  createdAt     DateTime @default(now())
}

model Ingredient {
  id             String              @id @default(uuid())
  organizationId String
  name           String
  code           String?             // SKU
  category       String              // MEAT, VEGETABLES, DAIRY, GROCERY, BEVERAGES, SEMI_FINISHED
  mainUnit       String              // KG, G, L, ML, PCS
  costPerUnit    Float               // Себестоимость KZT за единицу
  minStockLevel  Float               @default(0.0) // Порог предупреждения
  lossPercentage Float               @default(0.0) // % отхода (брутто -> нетто)
  isSemiFinished Boolean             @default(false)
  subRecipeId    String?             // Ссылка на техкарту для полуфабриката
  balances       StockBalance[]
  recipeItems    RecipeItem[]
  movementItems  StockMovementItem[]
}

model MenuItem {
  id                String       @id @default(uuid())
  organizationId    String
  posItemId         String       @unique // ID в системе Nexium
  name              String
  description       String?
  category          String
  sellingPrice      Float        // Цена продажи KZT
  imageUrl          String?
  isAvailable       Boolean      @default(true)
  stopListSource    String?      // "AUTO" | "MANUAL" | null
  stopListReason    String?      // Человекочитаемая причина
  stopListUpdatedAt DateTime?
  recipeCard        RecipeCard?
  createdAt         DateTime     @default(now())
}

model StopListEvent {
  id           String   @id @default(uuid())
  menuItemId   String
  menuItemName String
  action       String   // "AUTO_DISABLED" | "AUTO_ENABLED" | "MANUAL_DISABLED" | "MANUAL_ENABLED"
  reason       String?
  triggeredBy  String?  // userId для MANUAL_*, null для AUTO_*
  createdAt    DateTime @default(now())
}

model RecipeCard {
  id          String       @id @default(uuid())
  menuItemId  String?      @unique
  yieldAmount Float        @default(1.0)
  yieldUnit   String       @default("PCS")
  menuItem    MenuItem?    @relation(fields: [menuItemId], references: [id])
  items       RecipeItem[]
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt
}

model RecipeItem {
  id           String     @id @default(uuid())
  recipeCardId String
  ingredientId String
  grossAmount  Float      // Брутто (списываемый вес)
  netAmount    Float      // Нетто (чистый вес в блюде)
  unit         String     // KG, G, L, ML, PCS
  recipeCard   RecipeCard @relation(fields: [recipeCardId], references: [id], onDelete: Cascade)
  ingredient   Ingredient @relation(fields: [ingredientId], references: [id])
}

model StockBalance {
  id           String     @id @default(uuid())
  warehouseId  String
  ingredientId String
  quantity     Float      // Текущий остаток
  warehouse    Warehouse  @relation(fields: [warehouseId], references: [id])
  ingredient   Ingredient @relation(fields: [ingredientId], references: [id])

  @@unique([warehouseId, ingredientId])
}

model StockMovement {
  id          String              @id @default(uuid())
  warehouseId String
  type        String              // RECEIPT, AUTO_DEDUCTION, MANUAL_WRITE_OFF, INVENTORY_ADJUST, ORDER_CANCELLATION_REVERSAL
  referenceId String?             // ID чека Nexium или ONLINE-id
  comment     String?
  createdAt   DateTime            @default(now())
  warehouse   Warehouse           @relation(fields: [warehouseId], references: [id])
  items       StockMovementItem[]
}

model StockMovementItem {
  id              String        @id @default(uuid())
  stockMovementId String
  ingredientId    String
  quantity        Float         // Отрицательное = списание, Положительное = приход / реверс
  unitCost        Float         // Себестоимость KZT на момент операции
  stockMovement   StockMovement @relation(fields: [stockMovementId], references: [id], onDelete: Cascade)
  ingredient      Ingredient    @relation(fields: [ingredientId], references: [id])
}

model DeductionIncident {
  id             String   @id @default(uuid())
  receiptId      String
  ingredientId   String
  ingredientName String
  requestedQty   Float
  availableQty   Float
  shortageQty    Float
  createdAt      DateTime @default(now())
}

model Order {
  id            String      @id @default(uuid())
  branchId      String
  orderNumber   String      // e.g. "ORD-1001"
  type          String      // "DINE_IN_QR" | "PICKUP" | "DELIVERY"
  status        String      @default("NEW") // "NEW" | "ACCEPTED" | "PREPARING" | "READY" | "COMPLETED" | "CANCELLED"
  tableId       String?
  customerPhone String?
  totalAmount   Float
  comment       String?
  branch        Branch      @relation(fields: [branchId], references: [id])
  table         DiningTable? @relation(fields: [tableId], references: [id])
  items         OrderItem[]
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt
}

model OrderItem {
  id        String   @id @default(uuid())
  orderId   String
  posItemId String   // Ссылка на MenuItem.posItemId
  name      String
  quantity  Int
  price     Float
  order     Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
}
